{
  "name": "vaened/laroute",
  "description": "An enhanced Laravel extension to export named routes to JavaScript, allowing you to use route names instead of URLs. Supports route grouping for modular applications.",
  "keywords": [
    "laravel-library",
    "routes",
    "routing"
  ],
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Vaened\\Laroute\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Vaened\\Laroute\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Enea Dhack",
      "email": "enea.so@live.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/framework": "^v11.15|^12.0|^13.0",
    "vaened/support": "^4.0",
    "lambdish/phunctional": "^2.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "orchestra/testbench": "^9|^10|^11",
    "mockery/mockery": "^1.6"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Vaened\\Laroute\\LarouteServiceProvider"
      ]
    }
  }
}
